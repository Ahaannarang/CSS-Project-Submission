# ── Local development ────────────────────────────────────────────────────────
# Start Postgres with:
#   docker run -d --name berth-pg -e POSTGRES_PASSWORD=berth -e POSTGRES_USER=berth \
#     -e POSTGRES_DB=berth -p 55432:5432 postgres:16-alpine
DATABASE_URL=postgres://berth:berth@localhost:55432/berth

# ── Production (Neon) ────────────────────────────────────────────────────────
# Use the POOLED connection string (the host contains "-pooler"). The app detects
# it and turns off prepared statements, which pgbouncer's transaction mode cannot
# hold across statements.
# DATABASE_URL=postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/berth?sslmode=require
